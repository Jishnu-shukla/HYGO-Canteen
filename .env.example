# Copy this file to .env for local development, and set the same variables in
# your hosting provider's environment settings for deployment.

# Base URL of the backend API, including the /api prefix. Must be NEXT_PUBLIC_
# because the data layer fetches from the browser.
NEXT_PUBLIC_API_BASE_URL=https://your-backend.example.com/api

# Base URL of the auth service (hms-auth-service), no /api prefix. Must be
# NEXT_PUBLIC_ because the login page fetches from the browser.
NEXT_PUBLIC_AUTH_API_BASE_URL=http://localhost:8091

# Server-only key for the Spoonacular proxy routes. Never prefixed with
# NEXT_PUBLIC_ — it must not reach the browser.
SPOONACULAR_API_KEY=your-spoonacular-api-key
